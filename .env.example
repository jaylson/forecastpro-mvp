# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=forecastpro
POSTGRES_PORT=55432

# Database Connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/forecastpro

# Redis Configuration
REDIS_URL=redis://localhost:6379

# API Configuration
API_PORT=3000
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Authentication Configuration
# Firebase Admin SDK service account JSON (as string)
FIREBASE_SERVICE_ACCOUNT=

# WARNING: Only use AUTH_DISABLED=true in local development!
# This completely bypasses authentication and RBAC
# NEVER set this to true in production
AUTH_DISABLED=false

# Queue Worker Configuration
# Set to 'true' to enable background workers for forecasting and alerts
START_WORKERS=false

# Web Application Configuration
WEB_PORT=5173

# Firebase Web Configuration (for frontend)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# API URL (for frontend)
VITE_API_URL=http://localhost:3000

# Optional: Organization ID (for frontend)
VITE_ORG_ID=
